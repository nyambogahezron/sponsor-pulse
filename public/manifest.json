{
  "manifest_version": 3,
  "name": "SponsorPulse",
  "version": "0.1.0",
  "description": "Your YouTube companion — spot and manage sponsor segments effortlessly.",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [],

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
