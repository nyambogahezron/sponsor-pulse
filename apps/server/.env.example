# AI Provider
# Which LLM to use: gemini | openai | anthropic | deepseek
ACTIVE_LLM=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-20241022

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Server
PORT=3000

# Required for strict CORS lockdown. Enter your extension ID(s) here.
# For multiple IDs (e.g. different browsers), separate with commas.
# Find IDs at chrome://extensions after loading the extension in developer mode.
EXTENSION_ID=your_chrome_extension_id_here

# Database (used by Docker Compose)─
# These are read by compose.yaml to configure both the postgres container
# and the DATABASE_URL passed to the server container.
POSTGRES_USER=sponsor_pulse_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sponsor_pulse_db

# Assembled automatically by compose from the vars above — set this manually
# only when running the server outside Docker (e.g. bun run dev locally).
# DATABASE_URL=postgresql://sponsor_pulse_user:changeme@localhost:5432/sponsor_pulse_db

# Observability

# Optional: Protect the /metrics Prometheus scrape endpoint with a Bearer token.
# Leave empty to allow unauthenticated access (fine for internal Docker networks).
METRICS_TOKEN=

# Grafana admin credentials (used by compose.yaml).
# Defaults to admin/admin if not set — CHANGE in production.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Log level: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info
