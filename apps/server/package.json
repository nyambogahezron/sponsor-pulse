{
  "name": "server",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "cleanup": "rm -rf dist* node_modules package-lock.json bun.lock *.tsbuildinfo .turbo",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "pino-pretty": "^13.1.3"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "@hono/zod-validator": "^0.8.0",
    "@sponsor-pulse/shared": "workspace:*",
    "hono": "^4.12.23",
    "hono-rate-limiter": "^0.5.3",
    "pino": "^10.3.1",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.4.3"
  }
}
