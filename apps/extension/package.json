{
  "name": "extension",
  "private": true,
  "version": "0.1.1-beta",
  "type": "module",
  "scripts": {
    "build": "bun run build:chrome",
    "build:chrome": "tsc && BROWSER=chrome vite build",
    "build:firefox": "tsc && BROWSER=firefox vite build",
    "build:edge": "tsc && BROWSER=edge vite build",
    "build:safari": "tsc && BROWSER=safari vite build",
    "build:all": "bun run build:chrome && bun run build:firefox && bun run build:edge && bun run build:safari",
    "preview": "bunx serve dist/chrome",
    "check": "tsc -noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "cleanup": "rm -rf dist* node_modules package-lock.json bun.lock *.tsbuildinfo .turbo",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@sponsor-pulse/shared": "workspace:*",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/webextension-polyfill": "^0.12.5",
    "vite": "^8.0.12"
  }
}
