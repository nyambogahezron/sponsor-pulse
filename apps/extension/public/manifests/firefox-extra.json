{
  "manifest_version": 2,

  "permissions": [
    "*://*.youtube.com/*"
  ],

  "optional_permissions": [
    "*://*/*"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "sponsor-pulse@nyambogahezron.github.io",
      "strict_min_version": "102.0"
    },
    "gecko_android": {
      "strict_min_version": "113.0"
    }
  },

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "SponsorPulse AI",
    "default_area": "navbar",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "64":  "icons/icon64.png",
      "128": "icons/icon128.png",
      "256": "icons/icon256.png",
      "512": "icons/icon512.png"
    }
  },

  "web_accessible_resources": [
    "icons/icon16.png",
    "icons/icon32.png",
    "icons/icon48.png",
    "icons/icon64.png",
    "icons/icon128.png",
    "icons/icon256.png",
    "icons/icon512.png",
    "popup.html",
    "popup.css",
    "content.css",
    "browser-polyfill.js"
  ],

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["browser-polyfill.js", "content.js"],
      "run_at": "document_idle",
      "exclude_matches": ["https://accounts.youtube.com/*"]
    }
  ]
}
