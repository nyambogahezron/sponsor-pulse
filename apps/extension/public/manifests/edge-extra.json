{
  "_comment": "Edge uses the same Chromium engine as Chrome and fully supports MV3. This file re-uses the chrome-extra configuration.",
  "manifest_version": 3,

  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "web_accessible_resources": [{
    "resources": [
      "icons/icon16.png",
      "icons/icon32.png",
      "icons/icon48.png",
      "icons/icon64.png",
      "icons/icon128.png",
      "icons/icon256.png",
      "icons/icon512.png",
      "popup.html",
      "popup.css",
      "content.css"
    ],
    "matches": ["<all_urls>"],
    "use_dynamic_url": true
  }],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "SponsorPulse AI",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "64":  "icons/icon64.png",
      "128": "icons/icon128.png",
      "256": "icons/icon256.png",
      "512": "icons/icon512.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "exclude_matches": ["https://accounts.youtube.com/*"]
    }
  ]
}
