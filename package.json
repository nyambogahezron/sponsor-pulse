{
  "name": "sponsor-pulse-workspace",
  "private": true,
  "version": "0.1.0-beta",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "preview": "turbo preview",
    "check": "turbo check",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "cleanup": "turbo run cleanup ; rm -rf .turbo node_modules package-lock.json bun.lock *.tsbuildinfo",
    "format": "biome check --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@napi-rs/canvas": "^1.0.0",
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.9.1",
    "husky": "^9.1.7",
    "turbo": "^2.9.18",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
